# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (Dashboard -> Connect -> pooled connection)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Public base URL, used to build share links and email links
APP_URL=http://localhost:3029

# 'gemini' or 'mock'. With no GEMINI_API_KEY the mock is used automatically.
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey (server-only; never exposed to the browser)
GEMINI_API_KEY=
# Model names come from env so a retired model is a config change, not a code change.
AI_MODEL=gemini-3.5-flash-lite
AI_FAST_MODEL=gemini-3.1-flash-lite

# Optional: without it, emails are printed to the terminal instead of sent
RESEND_API_KEY=
EMAIL_FROM=Codewise <onboarding@resend.dev>

# Protects /api/cron/daily (Vercel sends it as "Authorization: Bearer <secret>")
CRON_SECRET=replace-with-a-long-random-string

# Passwords for the seeded demo accounts (npm run db:seed)
SEED_USER_PASSWORD=replace-me-user-password
SEED_ADMIN_PASSWORD=replace-me-admin-password
